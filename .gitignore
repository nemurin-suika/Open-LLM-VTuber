legacy/
chat_history/
knowledge_base/
submodules/MeloTTS
openapi_assistants.json
openapi_memgpt.json

# memory log
mem.json
conf.yaml.backup

*.exe

tmp/
private/
mcp_servers.json

.vscode/

*.lock

frontend

# Claude Code local settings
.claude/

